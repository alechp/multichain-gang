# Optional overrides for journal.config.json. Never place wallet secrets here.
JOURNAL_DB_PATH=data/journal.db
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
COLLECT_INTERVAL_MS=120000

# Optional public-data enrichment credentials/endpoints.
SOLSCAN_API_KEY=
JITO_API_URL=https://bundles.jito.wtf

# Robinhood Chain defaults to its rate-limited public RPC for manual reads.
# Set a provider URL before watch mode; the WebSocket is optional soft-state input.
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional comma-separated independent read endpoints for head-lag measurements.
ROBINHOOD_CHAIN_COMPARISON_RPC_URLS=
ROBINHOOD_CHAIN_WS_URL=

# HTML fallback remains disabled unless explicitly opted in.
SCRAPE_OK=0

# Optional JSON array replacing the checked-in watchlist seed.
# JOURNAL_WATCHLIST=[{"address":"11111111111111111111111111111111","label":"System program","tags":["program"]}]
